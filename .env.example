# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Banking Agentic Operations Platform
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   source .env   OR   export $(grep -v '^#' .env | xargs)
# ─────────────────────────────────────────────────────────────────────────────

# ── watsonx Orchestrate instance ─────────────────────────────────────────────
# Your instance URL — ends with /orchestrate for on-prem CPD,
# or https://<region>.assistant.watson.cloud.ibm.com for IBM Cloud SaaS.
WXO_URL=https://your-cpd-host.example.com/orchestrate

# Your API key (get it from: WXO_URL/build → user icon → Settings → API details)
WXO_API_KEY=your-api-key-here

# Environment name used by the ADK CLI (any label you choose)
WXO_ENV_NAME=my-banking-env

# ── Authentication type (auto-detected from URL in most cases) ────────────────
# Options: ibm_iam (IBM Cloud), mcsp (watsonx SaaS), cpd (on-prem)
# WXO_AUTH_TYPE=cpd

# ── For on-premises CPD deployments only ─────────────────────────────────────
# Set to "true" if your CPD instance uses a self-signed TLS certificate.
# WXO_INSECURE=true

# CPD admin credentials (only needed for scripts/login.sh --gen-token)
# CPD_USERNAME=cpadmin
# CPD_PASSWORD=your-cpd-password

# ── Optional: pre-set agent IDs after first deployment ───────────────────────
# These are populated by `orchestrate agents list` after you deploy.
# The test scripts (test_run.py, test_all_agents.py) use these IDs.
# Leave blank on first run — the deploy script will print the IDs.
#
# AGENT_CASE_SUPERVISOR=
# AGENT_CUSTOMER_360=
# AGENT_KYC_NRI=
# AGENT_CREDIT_BUREAU=
# AGENT_CREDIT_ASSESSMENT=
# AGENT_DOCUMENT=
# AGENT_COMPLIANCE_SUPERVISOR=
# AGENT_AML=
# AGENT_SANCTIONS=
# AGENT_FEMA=
# AGENT_FX=
# AGENT_PAYMENT=
